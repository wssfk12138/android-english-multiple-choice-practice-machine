<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Only LanSyncTransport resolves this reserved name, to a validated private IPv4. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">lan-sync.invalid</domain>
    </domain-config>
</network-security-config>
