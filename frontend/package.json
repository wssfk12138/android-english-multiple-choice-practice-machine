    "test:shared-candidate-interactions": "node tests/shared-candidate-interactions.mjs",
    "test:sync-coordinator": "node tests/sync-coordinator.mjs",
    "test:sync-retry-policy": "node tests/sync-retry-policy.mjs",
    "test:translation-queue-remediation": "node tests/translation-queue-remediation.mjs",
    "test:vocabulary-context-remediation": "node tests/vocabulary-context-remediation.mjs",
